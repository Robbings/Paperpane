{
  "name": "paperpane",
  "description": "Paperpane（纸窗）论文阅读扩展",
  "private": true,
  "version": "0.0.1",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:reader-features": "node tests/reader-features-extension.mjs",
    "test:extension": "node tests/arxiv-extension.mjs",
    "test:pdf-extension": "node tests/pdf-extension.mjs",
    "test:popup-extension": "node tests/popup-extension.mjs",
    "test:sources-extension": "node tests/sources-extension.mjs",
    "dev": "wxt -b chrome --mv3",
    "dev:edge": "wxt -b edge --mv3",
    "build": "wxt build -b chrome --mv3",
    "build:edge": "wxt build -b edge --mv3",
    "zip": "wxt zip -b chrome --mv3",
    "zip:edge": "wxt zip -b edge --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.31",
    "@assistant-ui/react-markdown": "0.14.24",
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@citation-js/plugin-csl": "0.9.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-mathematics": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "dompurify": "3.4.17",
    "js-tiktoken": "1.0.21",
    "jsonschema": "1.5.0",
    "katex": "0.16.47",
    "onnxruntime-web": "1.30.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "postcss-pxtorem": "6.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wxt": "0.21.4"
  }
}
