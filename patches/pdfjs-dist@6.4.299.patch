+// Paperpane continuous-highlight geometry adapter. Inputs are native PDF text rectangles in one coordinate system.
+// Merge adjacent fragments within a line; never take one bounding box across the whole selection.
+export function mergeHighlightRects(input) {
+  const rects=input.filter(r=>[r.x,r.y,r.width,r.height].every(Number.isFinite)&&r.width>0&&r.height>0).map(r=>({...r}));
+  const lines=[];
+  for(const r of rects.sort((a,b)=>(a.y+a.height/2)-(b.y+b.height/2)||a.x-b.x)){
+    const cy=r.y+r.height/2;
+    const line=lines.find(l=>Math.abs(cy-l.cy)<=Math.min(r.height,l.height)*0.36);
+    if(line){line.rects.push(r);}else lines.push({cy,height:r.height,rects:[r]});
+  }
+  const bands=[];
+  for(const line of lines){
+    let current;
+    for(const r of line.rects.sort((a,b)=>a.x-b.x)){
+      const gap=current?r.x-(current.x+current.width):Infinity;
+      // At most 1.25 text heights: bridge spaces and font-run splits, not broad column gutters.
+      if(current&&gap<=1.25*Math.min(current.height,r.height)){
+        const right=Math.max(current.x+current.width,r.x+r.width),bottom=Math.max(current.y+current.height,r.y+r.height);
+        current.x=Math.min(current.x,r.x);current.y=Math.min(current.y,r.y);
+        current.width=right-current.x;current.height=bottom-current.y;
+      }else{current={...r};bands.push(current);}
+    }
+  }
+  // Plane-sweep union produces disjoint rectangles. This is also safe for PDF QuadPoints export.
+  const ys=[...new Set(bands.flatMap(r=>[r.y,r.y+r.height]))].sort((a,b)=>a-b);
+  const output=[];let previous=new Map();
+  for(let i=0;i<ys.length-1;i++){
+    const y=ys[i],bottom=ys[i+1];if(bottom-y<1e-8)continue;
+    const spans=bands.filter(r=>r.y<bottom-1e-8&&r.y+r.height>y+1e-8).map(r=>[r.x,r.x+r.width]).sort((a,b)=>a[0]-b[0]);
+    const merged=[];
+    for(const span of spans){const last=merged.at(-1);if(last&&span[0]<=last[1]+1e-7)last[1]=Math.max(last[1],span[1]);else merged.push([...span]);}
+    const next=new Map();
+    for(const [x,right] of merged){const key=`${x}:${right}`;let r=previous.get(key);if(r&&Math.abs(r.y+r.height-y)<1e-7)r.height=bottom-r.y;else{r={x,y,width:right-x,height:bottom-y};output.push(r);}next.set(key,r);}
+    previous=next;
+  }
+  return output;
+}
