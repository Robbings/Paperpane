@@ -0,0 +1,13 @@
+// Viewer-scoped bridge; avoids global Canvas prototypes and window.theme.
+const viewers = new WeakMap();
+const canvases = new WeakMap();
+export function setPaperpaneViewerTheme(viewer, theme) {
+  if (theme) viewers.set(viewer, Object.freeze({ ...theme }));
+  else viewers.delete(viewer);
+}
+export function registerPaperpaneCanvas(canvas, viewer) {
+  const theme = viewer && viewers.get(viewer);
+  if (theme) canvases.set(canvas, theme);
+  else canvases.delete(canvas);
+}
+export function getPaperpaneCanvasTheme(canvas) { return canvases.get(canvas); }
